comment7.text=\r\n\ \u0412\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u0435\u0442\ \u0442\u0435\u043A\u0443\u0449\u0438\u0439\ \u0437\u0430\u0432\u0435\u0440\u0448\u0451\u043D\u043D\u044B\u0439\ \u043A\u0440\u0443\u0433\ \u043C\u0430\u0448\u0438\u043D\u044B\ (1-based\ \u0434\u043B\u044F\ HUD).\r\n\ \u041D\u0430\u043F\u0440\u0438\u043C\u0435\u0440\:\ 0\ \u0437\u0430\u0432\u0435\u0440\u0448\u0451\u043D\u043D\u044B\u0445\ \u043A\u0440\u0443\u0433\u043E\u0432\ \u2192\ \u043E\u0442\u043E\u0431\u0440\u0430\u0436\u0430\u0442\u044C\ "\u041A\u0440\u0443\u0433\ 1".\r\n
